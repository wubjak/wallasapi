# WallasAPI — Variables de entorno
# Copia este archivo a .env y completa los valores

# ─── SERVIDOR ───
WALLASAPI_HOST=127.0.0.1
WALLASAPI_PORT=8001

# ─── PROVIDERS (mínimo 2 recomendado para failover) ───

# Groq — el más rápido, gratis con límites generosos
# Obtén en: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini — gratis, muy buena calidad
# Obtén en: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# GitHub Models — gratis con tu cuenta de GitHub
# Obtén en: https://github.com/settings/tokens (scope: read:user)
GITHUB_TOKEN=

# OpenRouter — fallback de pago (algunos modelos gratis)
# Obtén en: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ─── OPCIONAL ───
# Cerebras — extremadamente rápido para Llama
CEREBRAS_API_KEY=

# Mistral — modelos europeos, buen OCR
MISTRAL_API_KEY=

# ─── WEB SEARCH (opcional pero recomendado para datos en tiempo real) ───
# DuckDuckGo no requiere API key (gratis)
# Google Custom Search Engine: https://programmablesearchengine.google.com/
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=
# SerpAPI: https://serpapi.com/
SERPAPI_KEY=

# ─── PROVIDERS ADICIONALES (opcionales) ───
# NVIDIA NIMs — casi todos tienen tier gratis
NVIDIA_API_KEY=
# Sambanova — rápido, gratis con límites
SAMBANOVA_API_KEY=
# HuggingFace — modelos open source gratuitos
HUGGINGFACE_API_KEY=
# Cohere — tier de prueba generoso
COHERE_API_KEY=

# ─── LOGGING ───
LOG_LEVEL=INFO
