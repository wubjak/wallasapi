# WallasAPI - Variables de Entorno
# Copia este archivo a .env y rellena con tus claves API.
# NUNCA subas tu archivo .env real a GitHub.

# === Proveedores 100% Gratuitos (Recomendados para empezar) ===
# Gemini (Google): https://ai.google.dev -> Create API key
GEMINI_API_KEY=tu_clave_aqui

# Groq: https://console.groq.com -> Sign Up -> API Keys
GROQ_API_KEY=tu_clave_aqui

# GitHub Models: https://github.com/settings/tokens -> Generate new token (classic)
GITHUB_TOKEN=tu_token_aqui

# OpenRouter: https://openrouter.ai -> Sign Up -> Keys
OPENROUTER_API_KEY=tu_clave_aqui

# Cerebras: https://cloud.cerebras.ai -> Sign Up -> API Keys
# (Opcional, gratis)
# CEREBRAS_API_KEY=tu_clave_aqui

# SambaNova: https://cloud.sambanova.ai -> API Keys
# SAMBANOVA_API_KEY=tu_clave_aqui

# HuggingFace: https://huggingface.co/settings/tokens
# HUGGINGFACE_API_KEY=tu_clave_aqui

# NVIDIA NIM: https://build.nvidia.com (free developer tier)
# NVIDIA_API_KEY=tu_clave_aqui

# === Proveedores de Pago (Opcionales) ===
# OpenAI: https://platform.openai.com
# OPENAI_API_KEY=tu_clave_aqui

# Mistral: https://console.mistral.ai
# MISTRAL_API_KEY=tu_clave_aqui

# Cohere: https://cohere.com
# COHERE_API_KEY=tu_clave_aqui

# === Operational Settings (optional) ===
# Bind address and port for the WallasAPI server.
# WALLAS_HOST=0.0.0.0
# WALLAS_PORT=8001

# OpenClaw / Claude Code optimizations: silences uvicorn access logs and
# enables agent-friendly streaming behavior. Defaults to true.
# WALLAS_OPENCLAW_MODE=true
# WALLAS_SILENT_AGENT=true

# How long the on-disk model registry cache is reused before refresh (seconds).
# WALLAS_MODELS_CACHE_TTL_SECONDS=3600

# Ollama-compatible gateway upstream. If unreachable, the catalog gracefully
# falls back to cloud-only models.
# OLLAMA_UPSTREAM=http://localhost:11434
# WALLAS_OLLAMA_VERSION=0.1.0-wallas

# === Seguridad (solo para despliegue en VPS) ===
# PROXY_API_KEY=clave_secreta_para_proteger_endpoints
