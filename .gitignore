# === WallasAPI .gitignore ===
# NUNCA subir claves API, entornos virtuales, ni archivos sensibles

# Variables de entorno y claves API (MUY IMPORTANTE)
.env
.env.local
.env.*.local
*.pem
*.key

# Entornos virtuales de Python
.venv/
venv/
ENV/
env/

# Cache de Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Archivos de datos locales (no codigo fuente)
models_cache.json
last_request.json
free_models_report.json
reminders.json
settings.json
models_raw.json
models_after_update.txt
models_final.txt
tmp_*.json
manual_install_log.txt
install_log*.txt
*.backup.v*
*.db
*.sqlite3

# Test debris / debug iteraciones
test_for*.bat
diagnose*.py
_test_*.py

# Logs y archivos temporales
*.log
logs/
tmp/
temp/
*.tmp
temp_context/
temp_media/

# IDEs y editores
.vscode/
.idea/
*.swp
*.swo
*~

# Sistema operativo
.DS_Store
Thumbs.db

# Archivos de distribucion / build
build/
dist/
*.egg-info/
*.egg

# Docker (si agregas luego)
docker-compose.override.yml
