# Normalize line endings across platforms.
* text=auto

# Shell scripts must keep LF or Linux refuses to execute them.
*.sh    text eol=lf
*.bash  text eol=lf

# Windows-only files keep CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Source code: LF in the repo, normalized on checkout per platform.
*.py    text eol=lf diff=python
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf

# Binary files — never touch line endings.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.7z    binary
*.gz    binary
*.tar   binary
